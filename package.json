    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
