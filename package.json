  "version": "1.0.0",
  "description": "MovieDock Backend API",
  "type": "module",
  "main": "dist/server.js",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
